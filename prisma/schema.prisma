generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TrainingDay {
  id        String     @id @default(cuid())
  cycleDay Int        @unique
  name      String
  exercises Exercise[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Exercise {
  id            String      @id @default(cuid())
  trainingDayId String
  trainingDay   TrainingDay @relation(fields: [trainingDayId], references: [id], onDelete: Cascade)
  sourceId      String      @unique
  name          String
  sets          Int
  targetReps    String
  rpe           String
  restSeconds   Int
  breath        String
  warmup        Boolean     @default(false)
  active        Boolean     @default(true)
  plannedWeightKg Decimal?  @db.Decimal(6, 2)
  plannedRepGoal Int?
  order         Int
  logs          SetLog[]
  metadata      ExerciseMetadata?
  suggestions   ProgressionSuggestion[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([trainingDayId, order])
}

model SetLog {
  id          String   @id @default(cuid())
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  cycleDay    Int
  cycleDate   DateTime @db.Date
  setNumber   Int
  weightKg    Decimal  @db.Decimal(6, 2)
  reps        Int
  rir         Int?
  actualRpe   Int?
  tempo       String?
  painLevel   Int?
  notes       String?
  restTakenSeconds Int?
  completedAt DateTime @default(now())

  @@unique([exerciseId, cycleDate, setNumber])
  @@index([cycleDate, cycleDay])
}

model PlanTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPlan {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model ExerciseMetadata {
  id                    String   @id @default(cuid())
  exerciseId            String   @unique
  exercise              Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  kind                  String
  primaryMuscles        String[]
  secondaryMuscles      String[]
  stabilizerMuscles     String[]
  videoUrl              String
  instructions          String[]
  commonMistakes        String[]
  technicalCues         String[]
  overloadRecommendation String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model BodyMetric {
  id          String   @id @default(cuid())
  date        DateTime @db.Date @unique
  bodyWeightKg Decimal @db.Decimal(6, 2)
  proteinGrams Int
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProgressionSuggestion {
  id              String   @id @default(cuid())
  exerciseId      String
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  reason          String
  action          String
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  @@index([status, createdAt])
  @@index([exerciseId, status])
}
