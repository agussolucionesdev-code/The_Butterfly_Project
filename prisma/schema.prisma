generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TrainingDay {
  id        String     @id @default(cuid())
  cycleDay Int        @unique
  name      String
  exercises Exercise[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Exercise {
  id            String      @id @default(cuid())
  trainingDayId String
  trainingDay   TrainingDay @relation(fields: [trainingDayId], references: [id], onDelete: Cascade)
  sourceId      String      @unique
  name          String
  sets          Int
  targetReps    String
  rpe           String
  restSeconds   Int
  breath        String
  warmup        Boolean     @default(false)
  active        Boolean     @default(true)
  plannedWeightKg Decimal?  @db.Decimal(6, 2)
  plannedRepGoal Int?
  lastProgressionReason String?
  lastProgressionAction String?
  lastProgressionAt DateTime?
  order         Int
  logs          SetLog[]
  metadata      ExerciseMetadata?
  suggestions   ProgressionSuggestion[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([trainingDayId, order])
}

model SetLog {
  id          String   @id @default(cuid())
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  cycleDay    Int
  cycleDate   DateTime @db.Date
  setNumber   Int
  setType     String   @default("working")
  approachOrder Int?
  weightKg    Decimal  @db.Decimal(6, 2)
  reps        Int
  rir         Int?
  actualRpe   Int?
  techniqueStatus String?
  tempo       String?
  tempoSeconds Int?
  holdSeconds Int?
  painLevel   Int?
  notes       String?
  restTakenSeconds Int?
  completedAt DateTime @default(now())

  @@unique([exerciseId, cycleDate, setType, setNumber])
  @@index([cycleDate, cycleDay])
  @@index([sessionId])
}

model WorkoutSession {
  id          String   @id @default(cuid())
  cycleDay    Int
  cycleDate   DateTime @db.Date
  status      String   @default("active")
  startedAt   DateTime @default(now())
  completedAt DateTime?
  notes       String?
  logs        SetLog[]

  @@unique([cycleDay, cycleDate])
  @@index([status, startedAt])
}

model PlanTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPlan {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model ExerciseMetadata {
  id                    String   @id @default(cuid())
  exerciseId            String   @unique
  exercise              Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  kind                  String
  primaryMuscles        String[]
  secondaryMuscles      String[]
  stabilizerMuscles     String[]
  videoUrl              String
  referenceUrl          String?
  referenceLabel        String?
  instructions          String[]
  commonMistakes        String[]
  technicalCues         String[]
  overloadRecommendation String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model BodyMetric {
  id          String   @id @default(cuid())
  date        DateTime @db.Date @unique
  bodyWeightKg Decimal @db.Decimal(6, 2)
  proteinGrams Int
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProgressionSuggestion {
  id              String   @id @default(cuid())
  exerciseId      String
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  evaluatedCycleDate DateTime @db.Date
  reason          String
  action          String
  status          String   @default("pending")
  autoApplied     Boolean  @default(false)
  targetWeightKg  Decimal? @db.Decimal(6, 2)
  targetRepGoal   Int?
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  @@unique([exerciseId, evaluatedCycleDate])
  @@index([status, createdAt])
  @@index([exerciseId, status])
}

model CoachRecommendation {
  id          String   @id @default(cuid())
  exerciseId  String?
  cycleDay    Int?
  cycleDate   DateTime? @db.Date
  scope       String   @default("daily")
  title       String
  message     String
  reason      String
  action      String
  source      String   @default("rules")
  status      String   @default("active")
  createdAt   DateTime @default(now())

  @@index([cycleDate, scope])
  @@index([exerciseId, createdAt])
}

model FoodItem {
  id          String   @id @default(cuid())
  name        String   @unique
  serving     String
  proteinGrams Decimal @db.Decimal(6, 2)
  calories    Int
  category    String
  budget      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
}

model NutritionLog {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  meal        String
  foodName    String
  quantity    Decimal  @db.Decimal(6, 2) @default(1)
  proteinGrams Decimal @db.Decimal(6, 2)
  calories    Int
  notes       String?
  createdAt   DateTime @default(now())

  @@index([date])
}

model HabitGoal {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  target      String
  active      Boolean  @default(true)
  order       Int      @default(1)
  createdAt   DateTime @default(now())
}

model HabitLog {
  id          String   @id @default(cuid())
  goalKey     String
  date        DateTime @db.Date
  completed   Boolean  @default(false)
  value       String?
  notes       String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([goalKey, date])
  @@index([date])
}

model ProgressPhoto {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  angle       String
  imageUrl    String
  publicId    String?
  notes       String?
  createdAt   DateTime @default(now())
  analyses    BodyAnalysis[]

  @@index([date])
}

model BodyAnalysis {
  id          String   @id @default(cuid())
  photoId     String
  photo       ProgressPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  summary     String
  focusAreas  String[]
  recommendations String[]
  postureNotes String[]
  source      String   @default("rules")
  createdAt   DateTime @default(now())

  @@index([photoId, createdAt])
}

model DailyChallenge {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  title       String
  description String
  category    String
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, category])
}
